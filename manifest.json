{
    "name": "AtomicHub-Bot",
    "version": "1.0",
    "manifest_version": 2,
    "content_scripts": [
        {
            "matches": ["https://wax.atomichub.io/market/sale/*"],
            "js": ["market.js"]
        },
        {
            "matches": ["https://wax.atomichub.io/drops/*"],
            "js": ["drops.js"]
        },
        {
            "matches": ["https://all-access.wax.io/"],
            "js": ["login.js"]
        },
        {
            "matches": ["https://all-access.wax.io/cloud-wallet/signing/"],
            "js": ["signing.js"]
        }
    ],
    "browser_action": {
        "default_popup": "popup.html",
        "default_title": "Bot"
    }
}